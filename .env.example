# Optional (HTTP servers): the server's own GHL account, used only for
# headerless requests and only when ALLOW_BASE_ACCOUNT=true (see below).
# Leave unset for multi-tenant deployments where every request supplies its
# own x-ghl-access-token/x-ghl-location-id headers.
GHL_API_KEY=your_private_integration_api_key_here

# Optional (HTTP servers): Location ID for GHL_API_KEY's account.
GHL_LOCATION_ID=your_location_id_here

# Optional: HighLevel API base URL.
GHL_BASE_URL=https://services.leadconnectorhq.com

# Optional: HighLevel API Version header (a named version, not a year).
# v3 is the current HighLevel API version (released 2026-06-11). Most modules
# use "v3"; ad-publishing remains mostly on 2021-07-28. Conversations use v3
# in current mode and 2021-04-15 in legacy v2 mode. The MCP routes the correct
# header per endpoint automatically.
GHL_API_VERSION=v3

# Optional: API generation toggle. "v3" (default) targets the current v3 API.
# Set to "v2" to opt into the legacy pre-v3 endpoint surface (removed endpoints
# like GET /contacts/ and GET /users/ become available again). In v2 mode the
# starter GHL_API_VERSION=v3 value is replaced by the 2023-02-21 fallback.
GHL_API_GENERATION=v3

# Optional: token/user type for the v3 access-level preflight. Set to
# "Location" for a sub-account token or "Company" for an agency token. When
# set, the MCP rejects calls to endpoints whose security scheme requires the
# other token type before hitting the API.
# GHL_USER_TYPE=Location

# Optional: default HTTP/SSE server port.
MCP_SERVER_PORT=8000
NODE_ENV=development

# Optional: only needed for future AI-assisted features.
OPENAI_API_KEY=your_openai_key_here_optional

# HTTP transport security, shared by main, legacy SSE, and MCP Apps.
# Local default: 127.0.0.1. Containers must bind 0.0.0.0 internally.
GHL_MCP_BIND_HOST=127.0.0.1
# Replaces remote defaults (chatgpt.com/chat.openai.com); loopback stays allowed.
# GHL_MCP_ALLOWED_ORIGINS=https://your-client.example
# GHL_MCP_ALLOWED_ORIGINS=none
# Required for the HTTP servers (main, legacy SSE, MCP Apps): operator shared
# secret for inbound Authorization: Bearer <secret>. Minimum 32 characters;
# the server refuses to start without it.
MCP_SHARED_SECRET=replace-with-a-random-secret-of-at-least-32-chars
# The server's own GHL account (GHL_API_KEY + GHL_LOCATION_ID above) is only
# used for headerless requests when explicitly enabled. Leave unset so every
# request must carry x-ghl-access-token and x-ghl-location-id.
# ALLOW_BASE_ACCOUNT=true
